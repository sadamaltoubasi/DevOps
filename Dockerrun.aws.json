{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "db01",
      "image": "579275327561.dkr.ecr.us-east-1.amazonaws.com/db01:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        { "hostPort": 3306, "containerPort": 3306 }
      ]
    },
    {
      "name": "app-bean",
      "image": "579275327561.dkr.ecr.us-east-1.amazonaws.com/app-bean:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        { "hostPort": 80, "containerPort": 8080 }
      ],
      "links": ["db01"]
    }
  ]
}